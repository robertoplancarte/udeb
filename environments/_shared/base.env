# Variables every repo gets, in every configuration.
# Resolution order (later wins): _shared/base.env, _shared/<config>.env,
# <repo>/base.env, <repo>/<config>.env, _shared/*.local.env,
# <repo>/*.local.env, --set flags.
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
REDIS_URL=redis://valkey:6379
S3_ENDPOINT=http://s3:8333
# Hook0 webhook server. HOOK0_API_KEY comes from _shared/hook0.local.env,
# which scripts/before_up.sh generates on each machine.
HOOK0_API_URL=http://hook0-api:8081/api/v1
