# Caddyfile for ude, scaffolded by `neptuno init`.
#
# One site block per repo; `neptuno add` appends one. Sites use http:// so
# Caddy skips its local certificate authority. Drop the prefix for HTTPS.

http://s3.localhost {
	reverse_proxy s3:8333
}

# Added by `neptuno add locke`
http://locke.localhost, http://*.locke.localhost, http://acme.localhost, http://globex.localhost {
	reverse_proxy locke:3000
}

http://hook0.localhost {
	reverse_proxy /api/* hook0-api:8081
	reverse_proxy hook0-frontend:80
}

http://mailpit.localhost {
	reverse_proxy mailpit:8025
}

# No http:// prefix: locke only accepts https issuers, so Caddy serves this
# with a certificate from its local authority (see compose.yml).
keycloak.localhost {
	reverse_proxy keycloak:8080
}
